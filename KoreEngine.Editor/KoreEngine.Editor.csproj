<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>KoreEngine</RootNamespace>

    <!-- Force MSBuild à tout recopier (ImGui.NET.dll, Roslyn, etc.) dans le dossier bin -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageReference Include="SDL3-CS" Version="3.4.20" />
    <PackageReference Include="SDL3-CS.Windows" Version="3.4.20" />
    <PackageReference Include="SDL3-CS.Windows.Image" Version="3.4.8.1" />
    <PackageReference Include="SDL3-CS.Windows.Mixer" Version="3.2.4.15" />
    <PackageReference Include="SDL3-CS.Windows.Shadercross" Version="3.0.0.15" />
    <PackageReference Include="SDL3-CS.Windows.TTF" Version="3.2.2.15" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="KoreEngine.Core">
      <HintPath>..\KoreEngine.Core\bin\Release\net10.0\KoreEngine.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
