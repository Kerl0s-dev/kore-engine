<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>KoreEngine</RootNamespace>

    <!-- Force MSBuild à tout recopier (ImGui.NET.dll, Roslyn, etc.) dans le dossier bin -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="SDL3-CS" Version="3.4.16.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <PackageReference Include="SDL3-CS.Windows" Version="3.4.16.2" />
    <PackageReference Include="SDL3-CS.Windows.Image" Version="3.4.6.11" />
    <PackageReference Include="SDL3-CS.Windows.Mixer" Version="3.2.4.12" />
    <PackageReference Include="SDL3-CS.Windows.Shadercross" Version="3.0.0.12" />
    <PackageReference Include="SDL3-CS.Windows.TTF" Version="3.2.2.12" />
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <PackageReference Include="SDL3-CS.Linux" Version="3.4.10.2" />
    <PackageReference Include="SDL3-CS.Linux.Image" Version="3.4.4.2" />
    <PackageReference Include="SDL3-CS.Linux.Mixer" Version="3.2.4.2" />
    <PackageReference Include="SDL3-CS.Linux.Shadercross" Version="3.0.0.2" />
    <PackageReference Include="SDL3-CS.Linux.TTF" Version="3.2.2.2" />
  </ItemGroup>

</Project>